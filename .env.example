# Bu dosyayı ".env.local" adıyla kopyalayın ve değerleri doldurun.
# .env.local git'e girmez.

# /admin paneli için şifre. Boş bırakılırsa admin API'si kapalıdır.
ADMIN_TOKEN=degistir-beni

# Birden fazla laptop kullanılırsa her birine farklı isim verin (kayıtlarda "device" olarak görünür).
NEXT_PUBLIC_DEVICE_ID=stand-1

# (İsteğe bağlı) Veritabanı dosyasının yeri. Varsayılan: data/game.db
# DB_PATH=D:\\Hsd-oyun\\data\\game.db
