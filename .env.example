# Supabase > Connect > Transaction pooler (port 6543).
# Replace password with its URL-encoded value. Never use NEXT_PUBLIC_ for this variable.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres

# Strong password for /admin. Empty disables administration.
ADMIN_TOKEN=
NEXT_PUBLIC_DEVICE_ID=web
